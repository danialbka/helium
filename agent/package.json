{
  "name": "helium-playwright-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official Playwright CLI with an existing Helium browser session",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "helium": "node bin/helium-playwright.mjs",
    "test": "node --test tests/*.test.mjs",
    "benchmark:public": "node benchmarks/public-read.mjs",
    "benchmark:workflows": "node benchmarks/workflows.mjs",
    "benchmark:output": "node benchmarks/output-modes.mjs",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "benchmark:baseline": "node scripts/freeze-baseline.mjs",
    "test:browser": "node tests/browser-live.mjs",
    "test:windows": "node tests/window-live.mjs"
  },
  "dependencies": {
    "@playwright/cli": "0.1.21"
  }
}
